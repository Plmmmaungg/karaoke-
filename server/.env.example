PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Copy this file to .env and fill in your real RapidAPI details.
RAPIDAPI_KEY=
RAPIDAPI_HOST=
# Use the exact search endpoint shown by your RapidAPI provider.
# Include {query} where the search term should go, e.g. https://provider.example/search?q={query}
RAPIDAPI_SEARCH_URL=
RAPIDAPI_METHOD=GET
RAPIDAPI_QUERY_PARAM=query
